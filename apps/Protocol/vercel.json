{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "npx --yes turbo@^2 query affected --base=$VERCEL_GIT_PREVIOUS_SHA --packages protocol-app --exit-code",
  "installCommand": "cd ../.. && npm install",
  "buildCommand": "cd ../.. && npm run build --workspace=apps/Protocol",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
