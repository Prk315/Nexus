{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexus Local",
  "version": "0.16.0",
  "identifier": "com.bastianthomsen.nexuslocal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1426",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Nexus Local",
        "width": 400,
        "height": 560,
        "minWidth": 360,
        "minHeight": 420,
        "resizable": true,
        "visible": false,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "default",
          "description": "Default capability",
          "windows": [
            "main"
          ],
          "permissions": [
            "core:default",
            "opener:default"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "developmentTeam": "G9D6JYJSLT",
      "minimumSystemVersion": "14.0"
    }
  }
}
