# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
out/

# Rust / Tauri
target/
**/src-tauri/target/

# Tauri bundles
**/src-tauri/gen/
# Allow the iOS project.yml (xcodegen config) to be committed so the
# ENABLE_USER_SCRIPT_SANDBOXING: NO fix survives tauri ios init regeneration.
!**/src-tauri/gen/apple/project.yml
!**/src-tauri/gen/apple/timetracker-app_iOS/timetracker-app_iOS.entitlements
**/*.dmg
**/*.AppImage
**/*.deb
**/*.msi
**/*.exe

# Environment
.env
.env.local
.env.*.local

# iOS secrets (Supabase keys etc.)
**/Secrets.swift

# Logs
*.log
npm-debug.log*

# Editor
.DS_Store
.vscode/
.idea/
*.swp

# Agent / tooling config (machine-local): settings, job scratch, and the git
# worktrees agents run in — none of which belong to anyone but this machine.
#
# `.claude/*` rather than `.claude/`, and the difference is load-bearing: git
# will not descend into an excluded DIRECTORY, so a `!` negation underneath one
# can never re-include anything. Ignoring the contents instead leaves the door
# open for the exception below.
#
# ⚠️ Keep this as `*` plus explicit negations. Un-ignoring `.claude/` wholesale
# would start tracking `.claude/worktrees/`, which contains checkouts of this
# same repository — a repository inside itself.
.claude/*

# Skills are project knowledge, not machine state. A skill that only exists on
# one laptop is worse than none: every other session, checkout and CI run
# silently lacks the thing the docs point at.
!.claude/skills/

# R (RStudio leaves these next to any script it runs)
.Rhistory
.RData
.Rproj.user/

# Stray scratch files
.__wtest

# Turbo
.turbo/

# Python
__pycache__/
*.pyc
.venv/

# Supabase CLI scratch
supabase/.temp/
