# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
out/

# Rust / Tauri
target/
**/src-tauri/target/

# Tauri bundles
**/src-tauri/gen/
# Allow the iOS project.yml (xcodegen config) to be committed so the
# ENABLE_USER_SCRIPT_SANDBOXING: NO fix survives tauri ios init regeneration.
!**/src-tauri/gen/apple/project.yml
!**/src-tauri/gen/apple/timetracker-app_iOS/timetracker-app_iOS.entitlements
**/*.dmg
**/*.AppImage
**/*.deb
**/*.msi
**/*.exe

# Environment
.env
.env.local
.env.*.local

# iOS secrets (Supabase keys etc.)
**/Secrets.swift

# Logs
*.log
npm-debug.log*

# Editor
.DS_Store
.vscode/
.idea/
*.swp

# Agent / tooling config (machine-local)
.claude/

# R (RStudio leaves these next to any script it runs)
.Rhistory
.RData
.Rproj.user/

# Stray scratch files
.__wtest

# Turbo
.turbo/

# Python
__pycache__/
*.pyc
.venv/

# Supabase CLI scratch
supabase/.temp/
