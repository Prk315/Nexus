      "parameters": {
        "method": "GET",
        "url": "https://efxmzsdisaymtpebaxlp.supabase.co/rest/v1/pf_tasks",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "select",
              "value": "id,title,priority,due_date,done"
            },
            {
              "name": "done",
              "value": "eq.false"
            },
            {
              "name": "order",
              "value": "due_date.asc.nullslast"
            },
