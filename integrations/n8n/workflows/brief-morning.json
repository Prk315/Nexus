          "name": "Nexus Supabase"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "append"
      },
      "id": "merge-data",
      "name": "Merge All Data",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        500,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nlet weather = null, calendar = [], tasks = [];\n\nfor (const item of items) {\n  const data = item.json;\n  if (data.current_condition) {\n    const current = data.current_condition[0]; const today = data.weather?.[0];\n    weather = {temp: current.temp_C, feels: current.FeelsLikeC, condition: current.weatherDesc[0].value, high: today?.maxtempC, low: today?.mintempC};\n  } else if (data.summary || data.start) {\n    const start = data.start?.dateTime || data.start?.date;\n    const isAllDay = !data.start?.dateTime;\n    let timeStr = isAllDay ? 'All day' : new Date(start).toLocaleTimeString('da-DK', {hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Copenhagen'});\n    calendar.push({title: data.summary || 'Untitled', time: timeStr, location: data.location || '', start: start});\n  } else if (data.done !== undefined || (data.title !== undefined && data.id !== undefined)) {\n    // A pf_tasks row from PostgREST.\n    //\n    // Notion used to answer with ONE item wrapping many pages (`data.results`),\n    // so this branch looped. PostgREST returns a bare array and n8n splits it\n    // into one item per row, so there is nothing to loop over — each pass\n    // handles a single task. Keeping the old loop here would silently drop\n    // every task but the first.\n    //\n    // Ordering is done in SQL (`order=due_date.asc.nullslast`), not here.\n    const deadline = data.due_date;\n    let deadlineStr = '';\n    if (deadline) {\n      // due_date is a DATE ('YYYY-MM-DD'); parse as UTC midnight so a local\n      // timezone cannot shift it a day and turn 'today' into 'OVERDUE'.\n      const d = new Date(deadline + 'T00:00:00Z');\n      const today = new Date(); today.setUTCHours(0,0,0,0);\n      const diffDays = Math.round((d - today) / 86400000);\n      if (diffDays < 0) deadlineStr = '⚠️ OVERDUE';\n      else if (diffDays === 0) deadlineStr = '📍 Today';\n      else if (diffDays === 1) deadlineStr = 'Tomorrow';\n      else deadlineStr = d.toLocaleDateString('da-DK', {day: 'numeric', month: 'short', timeZone: 'UTC'});\n    }\n    tasks.push({title: data.title || 'Untitled', deadline: deadlineStr, priority: data.priority || ''});\n  }\n}\n\ncalendar.sort((a, b) => new Date(a.start) - new Date(b.start));\nconst seen = new Set(); calendar = calendar.filter(e => { const key = e.title + e.start; if (seen.has(key)) return false; seen.add(key); return true; });\n\nlet msg = `☀️ *Good morning, Bastian!*\\n_${new Date().toLocaleDateString('da-DK', {weekday: 'long', day: 'numeric', month: 'long'})}_\\n\\n`;\nif (weather) msg += `🌡️ *Weather:* ${weather.temp}°C (feels ${weather.feels}°C) — ${weather.condition}\\n↗️ High ${weather.high}°C / ↘️ Low ${weather.low}°C\\n\\n`;\nif (calendar.length > 0) { msg += `📅 *Today (${calendar.length} events):*\\n`; for (const e of calendar.slice(0, 8)) { msg += `• ${e.time} — ${e.title}`; if (e.location) msg += ` _(${e.location})_`; msg += `\\n`; } if (calendar.length > 8) msg += `_...and ${calendar.length - 8} more_\\n`; msg += `\\n`; } else { msg += `📅 *Calendar:* No events today\\n\\n`; }\nif (tasks.length > 0) { msg += `✅ *Tasks (${tasks.length}):*\\n`; for (const t of tasks.slice(0, 5)) { let line = `• ${t.title}`; if (t.deadline) line += ` — ${t.deadline}`; if (t.priority === 'high') line += ` 🔴`; msg += line + `\\n`; } if (tasks.length > 5) msg += `_...and ${tasks.length - 5} more_\\n`; } else { msg += `✅ *Tasks:* All clear!\\n`; }\nmsg += `\\n_Have a great day!_ 🔮`;\nreturn [{ json: { slackMessage: msg } }];"
      },
