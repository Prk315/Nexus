      "id": "fetch-notion",
      "name": "Tasks (pf_tasks)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        600
      ],
      "credentials": {
        "supabaseApi": {
